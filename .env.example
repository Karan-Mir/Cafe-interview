# Copy to .env.local and fill from Supabase → Project Settings → API.
# Both values are PUBLIC by design: the anon key is meant to ship in the client,
# and it is useless on its own because RLS grants anon nothing (see supabase/schema.sql).
# Never put the service_role key here or anywhere in this repo.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
